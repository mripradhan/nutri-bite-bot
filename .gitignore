# datasets and research documents
# MIMIC-IV is PhysioNet credentialed data — never commit it (DUA)
mimic IV/
physionet.org/
mimic-iv-clinical-database-demo-*/
*.csv.gz
# derived MIMIC extracts are row-level too; only aggregate cohort cards may be committed
data/derived/*
!data/derived/cohort_card_*.json
*.csv
*.zip
*.parquet
*.pdf
*.tex

# env / caches
.env
.venv/
__pycache__/
*.joblib
*.pkl
*.h5

# dev-session artifacts (logs, temp outputs, task tracking)
*.log
*_status.json
temp_*.txt
task.md
test_output.txt
test_result.txt
test_out.log
db_activity.txt

# force-include runtime-required data files (needed for HF Spaces)
# MUST come after wildcard rules above — last matching rule wins
!clinical-models/ifct_database.csv
# Model 1 artifacts are json + .pt (not ignored); aggregate metric CSVs are safe to commit
!artifacts/models/reports/*.csv
!artifacts/models/reports/evaluation/*.csv
!artifacts/models/reports/usecase_table.tex
# pre-revision artifacts kept locally as evidence for the response letter
artifacts/models/_legacy_pre_revision/
# ablation models: keep reports, not weights
artifacts/experiments/*/tabnet/
!artifacts/experiments/*/reports/*.csv
!artifacts/experiments/*/reports/evaluation/*.csv

# tooling
.claude/
